# PharmaPulse — Environment Variables
#
# Copy this file to .env and fill in your Firebase project credentials.
# Never commit .env to version control. This file must contain variable
# NAMES only — never paste real values into .env.example.
#
# Get these values from:
#   Firebase Console → Project Settings → General → Your apps → Web app → SDK setup

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional build-time flag — currently not read anywhere in src/ (see
# docs/production/SECRET_ROTATION_CHECKLIST.md). Kept here for parity
# with netlify.toml's per-context values.
VITE_DEMO_MODE=

# ── Universal AI Intake Phase 2 — Connector (Netlify Function only) ──
# These are SERVER-SIDE variables read only by netlify/functions/
# pharmapulse-connector.ts (via process.env). They are NEVER prefixed
# with VITE_, so Vite never inlines them into the client bundle, and
# they must be set in the Netlify dashboard's environment variables —
# never in a committed file. Every flag below defaults to "disabled"
# when unset (fail closed) — see AI_INTAKE_PHASE_2_ENVIRONMENT.md.

# Master on/off switch. Must be exactly "true" to accept any connector
# request at all (even read-only tools).
CONNECTOR_ENABLED=

# Separate switch specifically for the one write-capable tool
# (pharmapulse_execute_intake_session). Both this AND CONNECTOR_ENABLED
# must be "true" for an execute call to succeed.
CONNECTOR_PRODUCTION_WRITES_ENABLED=

# One of: production | staging | development
CONNECTOR_ENVIRONMENT=

# HMAC signing secret for connector access tokens (connectorTokenService.ts).
# Generate a long random value; never reuse across environments.
CONNECTOR_TOKEN_SECRET=

# HMAC signing secret for approval tokens (connectorApprovalService.ts).
# Must be different from CONNECTOR_TOKEN_SECRET.
CONNECTOR_APPROVAL_SECRET=

CONNECTOR_AUDIENCE=pharmapulse-connector
CONNECTOR_ISSUER=pharmapulse

# JSON string mapping a connector clientId to the protected admin's
# Firestore uid it is allowed to act as, e.g.
# '{"chatgpt-primary":"<the real admin uid>"}'. A clientId with no
# entry here is rejected (UNAUTHORIZED) — never impersonates an
# arbitrary user.
CONNECTOR_CLIENT_ADMIN_MAP=

# Firebase Admin SDK service-account credentials, as a single-line
# JSON string (paste the full downloaded service-account key JSON).
# NEVER commit this value, NEVER put it in a file in this repo — set
# it only as a Netlify dashboard secret environment variable.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Critical Risk Alert email relay (netlify/functions/pharmapulse-send-alert.ts) ──
# Server-side only. Both RESEND_API_KEY and ALERT_RECIPIENT_EMAILS must
# be set for the "Send alert email" admin action to work — unset means
# the function fails closed (501), never a silent no-op.

# API key from https://resend.com (or swap the function's fetch call
# for another provider's API if preferred).
RESEND_API_KEY=

# Comma-separated list of recipient email addresses, e.g.
# "ops@example.com,regional-manager@example.com"
ALERT_RECIPIENT_EMAILS=

# Optional — defaults to "PharmaPulse Alerts <alerts@pharmapulse.app>"
# if unset. Must be a domain verified with your Resend account.
ALERT_SENDER_EMAIL=
